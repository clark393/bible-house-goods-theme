{% liquid
  assign is_bible_band = false
  if product.handle == 'the-bible-band'
    assign is_bible_band = true
  endif
  assign product_form_id = 'ProductForm-' | append: section.id
  assign demo_media = blank
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign demo_media = media
      break
    endif
  endfor
%}
<section class="product-page page-width">
  <div class="product-layout">
    <div class="product-gallery-wrap" data-product-gallery>
      <div class="product-gallery" data-product-gallery-track>
        {% for media in product.media %}<div class="product-gallery__item" data-product-gallery-slide data-media-id="{{ media.id }}">{% if media.media_type == 'image' %}{{ media | image_url: width: 1600 | image_tag: widths: '400,700,1000,1600', loading: 'lazy', alt: media.alt | default: product.title }}{% else %}{{ media | media_tag: image_size: '1600x' }}{% endif %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endfor %}
      </div>
      {% if product.media.size > 1 %}
        <div class="product-gallery__controls">
          <button class="product-gallery__button" type="button" data-gallery-previous aria-label="{{ 'products.gallery.previous' | t }}">&larr;</button>
          <p class="product-gallery__counter" aria-live="polite"><span data-gallery-current>1</span> / {{ product.media.size }}</p>
          <button class="product-gallery__button" type="button" data-gallery-next aria-label="{{ 'products.gallery.next' | t }}">&rarr;</button>
        </div>
      {% endif %}
    </div>
    <div class="product-info">
      {% if product.vendor != blank %}<span class="eyebrow">{{ product.vendor }}</span>{% endif %}
      <h1>{% render 'trademark-title', title: product.title %}</h1>
      <p class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      {% if settings.social_etsy_url != blank %}
        <a class="product-review-link" href="{{ settings.social_etsy_url }}" target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span> Read customer reviews on Etsy ↗</a>
      {% endif %}
      {% if is_bible_band %}
        <div class="product-proof" aria-label="Product testimonial">
          <span class="product-proof__stars" aria-hidden="true">★★★★★</span>
          <blockquote>“{{ section.settings.testimonial_quote }}”</blockquote>
          <cite>— {{ section.settings.testimonial_cite }}</cite>
        </div>
      {% endif %}
      {% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="properties[Gift packaging]" value="Included free" disabled data-gift-packaging-property>
        {% unless product.has_only_default_variant %}<div><label class="field-label" for="Variant-{{ section.id }}">Choose an option</label><select id="Variant-{{ section.id }}" data-variant-select data-product-title="{{ product.title | escape }}">{% for variant in product.variants %}{% assign is_preorder = false %}{% if variant.option2 == 'Cobalt Blue / Grey Aztec' or variant.option2 == 'Space Grey / Sport Grey' or variant.option2 == 'Pink Bubblegum / Bubblegum Check' or variant.option2 == 'Maroon / Maroon Aztec' %}{% assign is_preorder = true %}{% endif %}<option value="{{ variant.id }}" data-available="{{ variant.available }}" data-preorder="{{ is_preorder }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" data-variant-title="{{ variant.title | escape }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}>{{ variant.title }}{% if is_preorder %} — Preorder{% elsif variant.available == false %} — Sold out{% endif %}</option>{% endfor %}</select></div>{% endunless %}
        {% if section.settings.enable_share_offer and is_bible_band %}
          <fieldset class="share-offer" data-share-offer>
            <legend class="field-label">{{ 'products.share_offer.legend' | t }}</legend>
            <label class="share-offer__choice">
              <input type="radio" name="purchase-option" value="single" checked data-purchase-option>
              <span><strong>{{ 'products.share_offer.single_title' | t }}</strong><small>{{ 'products.share_offer.single_copy' | t }}</small></span>
            </label>
            <label class="share-offer__choice share-offer__choice--featured">
              <input type="radio" name="purchase-option" value="share" data-purchase-option>
              <span><strong>{{ section.settings.share_heading }}</strong><small>{{ section.settings.share_copy }}</small></span>
              <b>{{ section.settings.share_badge }}</b>
            </label>
            <div class="share-offer__recipient" data-share-recipient hidden>
              <label class="field-label" for="Share-recipient-{{ section.id }}">{{ 'products.share_offer.recipient_label' | t }}</label>
              <input id="Share-recipient-{{ section.id }}" type="text" name="properties[{{ 'products.share_offer.recipient_property' | t }}]" placeholder="{{ 'products.share_offer.recipient_placeholder' | t }}" disabled data-share-recipient-input>
            </div>
            <input type="hidden" name="properties[{{ 'products.share_offer.purpose_property' | t }}]" value="{{ 'products.share_offer.purpose_value' | t }}" disabled data-share-property>
          </fieldset>
        {% endif %}
        <div><label class="field-label" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"></div>
        {% assign selected_is_preorder = false %}
        {% if product.selected_or_first_available_variant.option2 == 'Cobalt Blue / Grey Aztec' or product.selected_or_first_available_variant.option2 == 'Space Grey / Sport Grey' or product.selected_or_first_available_variant.option2 == 'Pink Bubblegum / Bubblegum Check' or product.selected_or_first_available_variant.option2 == 'Maroon / Maroon Aztec' %}
          {% assign selected_is_preorder = true %}
        {% endif %}
        <button class="button" type="submit" data-primary-product-submit data-product-title="{{ product.title | escape }}"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if selected_is_preorder %}Preorder{% elsif product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
        {% if is_bible_band %}
          <ul class="purchase-reassurance" aria-label="Purchase reassurance">
            <li><strong>Free shipping</strong><span>on Bible Band orders</span></li>
            <li><strong>No app</strong><span>tap and open</span></li>
            <li><strong>No subscription</strong><span>ever</span></li>
            <li><strong>Compatible</strong><span>iPhone &amp; Android</span></li>
            <li><strong>Delivery</strong><span>typically 3–7 business days</span></li>
            <li><strong>Easy returns</strong><span>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">View return policy</a>{% else %}Contact us for help{% endif %}</span></li>
          </ul>
        {% endif %}
        {{ form | payment_button }}
        {% render 'payment-options' %}
      {% endform %}
      {% if is_bible_band and section.settings.show_demo_video %}
        <aside class="tap-demo" aria-labelledby="TapDemoTitle-{{ section.id }}">
          <div class="tap-demo__heading">
            <span class="eyebrow">See it in seconds</span>
            <h2 id="TapDemoTitle-{{ section.id }}">Tap. Open. Begin.</h2>
            <p>Watch the Bible Band open today’s Scripture and prayer with one quick tap.</p>
          </div>
          <div class="tap-demo__media" data-tap-demo data-demo-duration="5">
            {% if section.settings.demo_video != blank %}
              {{ section.settings.demo_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
            {% elsif demo_media != blank %}
              {{ demo_media | media_tag: autoplay: true, loop: true, muted: true, controls: true }}
            {% else %}
              <div class="tap-demo__placeholder"><span>Tap</span><strong>Today’s Scripture</strong><small>No app needed</small></div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
      {% if section.settings.enable_social_share %}{% render 'product-share', product: product, share_url: canonical_url %}{% endif %}
      <div class="rte">{{ product.description }}</div>
      <div class="product-meta"><details><summary>Shipping &amp; delivery</summary><div class="rte"><p>Shipping and delivery options are shown at checkout. Digital products are delivered according to their product description.</p></div></details><details><summary>Questions?</summary><div class="rte"><p>Visit our FAQ or contact Bible House Goods and we'll be glad to help.</p></div></details></div>
    </div>
  </div>
</section>

<div class="mobile-purchase-bar" data-mobile-purchase-bar>
  <div>
    <strong>{% if is_bible_band %}The Bible Band™{% else %}{{ product.title }}{% endif %}</strong>
    <span data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>
  </div>
  <button class="button button--gold" type="button" data-sticky-add aria-controls="{{ product_form_id }}"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
    {% if selected_is_preorder %}Preorder{% elsif product.selected_or_first_available_variant.available %}{% if is_bible_band %}Get Your Bible Band{% else %}Add to Cart{% endif %}{% else %}Sold out{% endif %}
  </button>
</div>

{% if product.handle == 'the-bible-band' and section.settings.show_bible_band_sections %}
  <section class="dark-section">
    <div class="page-width">
      <span class="eyebrow">{{ 'products.bible_band.how_it_works' | t }}</span>
      <h2 class="section-title">{{ 'products.bible_band.discipleship_title' | t }}</h2>
      <div class="steps-grid">
        <div class="step"><div class="step__number">1</div><h3>{{ 'products.bible_band.wear_title' | t }}</h3><p>{{ 'products.bible_band.wear_copy' | t }}</p></div>
        <div class="step"><div class="step__number">2</div><h3>{{ 'products.bible_band.tap_title' | t }}</h3><p>{{ 'products.bible_band.tap_copy' | t }}</p></div>
        <div class="step"><div class="step__number">3</div><h3>{{ 'products.bible_band.read_title' | t }}</h3><p>{{ 'products.bible_band.read_copy' | t }}</p></div>
      </div>
    </div>
  </section>

  <section class="daily-preview" aria-labelledby="ProductDailyPreview-{{ section.id }}">
    <div class="page-width daily-preview__layout">
      <div class="daily-preview__intro">
        <span class="eyebrow">{{ section.settings.sample_kicker }}</span>
        <h2 class="display-title" id="ProductDailyPreview-{{ section.id }}">{{ section.settings.sample_heading }}</h2>
        <p>{{ section.settings.sample_intro }}</p>
        <div class="daily-preview__included" aria-label="{{ 'products.bible_band.included_label' | t }}">
          <span>{{ 'products.bible_band.scripture_label' | t }}</span><span>{{ 'products.bible_band.devotion_label' | t }}</span><span>{{ 'products.bible_band.prayer_label' | t }}</span><span>{{ 'products.bible_band.audio_label' | t }}</span><span>{{ 'products.bible_band.plan_label' | t }}</span>
        </div>
      </div>
      <div class="daily-preview__device">
        <article class="daily-preview__card">
          <header class="daily-preview__app-head">
            <div class="daily-preview__brand"><span aria-hidden="true">✦</span><strong>The Bible Band</strong></div>
            <span class="daily-preview__day">{{ section.settings.sample_day }}</span>
          </header>
          <div class="daily-preview__progress" aria-label="{{ section.settings.sample_day }}"><span></span></div>
          <div class="daily-preview__welcome">
            <span>{{ section.settings.sample_date }}</span>
            <p>{{ section.settings.sample_label }}</p>
            <h3>{{ section.settings.sample_title }}</h3>
          </div>
          <div class="daily-preview__verse-card">
            <span class="daily-preview__label">{{ 'products.bible_band.scripture_label' | t }}</span>
            <blockquote>“{{ section.settings.sample_verse }}”</blockquote>
            <cite>{{ section.settings.sample_reference }}</cite>
          </div>
          <section class="daily-preview__section">
            <div class="daily-preview__section-head"><span class="daily-preview__number">01</span><h4>{{ 'products.bible_band.devotion_label' | t }}</h4></div>
            <p>{{ section.settings.sample_devotion | newline_to_br }}</p>
          </section>
          <section class="daily-preview__section daily-preview__prayer">
            <div class="daily-preview__section-head"><span class="daily-preview__number">02</span><h4>{{ 'products.bible_band.prayer_label' | t }}</h4></div>
            <p>{{ section.settings.sample_prayer }}</p>
          </section>
          <div class="daily-preview__extras">
            <div class="daily-preview__extra">
              <span class="daily-preview__play" aria-hidden="true">▶</span>
              <span><strong>Listen to today’s reflection</strong><small>{{ section.settings.sample_audio }}</small></span>
            </div>
            <div class="daily-preview__extra">
              <span class="daily-preview__book" aria-hidden="true">¶</span>
              <span><strong>Today’s Bible reading</strong><small>{{ section.settings.sample_reading }}</small></span>
            </div>
          </div>
          <footer><span class="daily-preview__cached">Static sample</span>{{ section.settings.sample_source }}</footer>
        </article>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_bible_band_sections", "label": "Show Bible Band discipleship sections", "default": true },
    { "type": "header", "content": "Proof and tap demonstration" },
    { "type": "textarea", "id": "testimonial_quote", "label": "Testimonial", "default": "I created The Bible Band to help families keep God’s Word close in the middle of everyday life." },
    { "type": "text", "id": "testimonial_cite", "label": "Testimonial attribution", "default": "Clark Whitney, founder & pastor" },
    { "type": "checkbox", "id": "show_demo_video", "label": "Show tap demonstration", "default": true },
    { "type": "video", "id": "demo_video", "label": "3–5 second tap demonstration", "info": "Upload a short, muted clip showing a phone tapping the band and opening the daily experience." },
    { "type": "header", "content": "Cached daily devotion sample" },
    { "type": "text", "id": "sample_kicker", "label": "Kicker", "default": "See What One Tap Opens" },
    { "type": "text", "id": "sample_heading", "label": "Heading", "default": "A Real Daily Devotion" },
    { "type": "textarea", "id": "sample_intro", "label": "Introduction", "default": "This static sample from TheBibleBand.com shows the kind of Scripture, pastor-written reflection, and guided prayer your band opens each day." },
    { "type": "text", "id": "sample_label", "label": "Card label", "default": "Today’s Word" },
    { "type": "text", "id": "sample_date", "label": "Sample date", "default": "Friday, July 24" },
    { "type": "text", "id": "sample_day", "label": "Plan progress", "default": "Day 205 of 365" },
    { "type": "text", "id": "sample_title", "label": "Devotion title", "default": "Finish Strong" },
    { "type": "textarea", "id": "sample_verse", "label": "Scripture", "default": "For it came to pass, when Solomon was old, that his wives turned away his heart after other gods: and his heart was not perfect with the LORD his God, as was the heart of David his father." },
    { "type": "text", "id": "sample_reference", "label": "Scripture reference", "default": "1 Kings 11:4 · KJV" },
    { "type": "textarea", "id": "sample_devotion", "label": "Devotion", "default": "In Super Bowl LI, the Atlanta Falcons led the New England Patriots 28–3 in the third quarter. Although the statistical models said their chance of winning was 99.8%, the Falcons let off the gas and the Patriots rallied to win in overtime. As the saying goes, it’s not how you start, it’s how you finish.\n\nAlthough King Solomon was the wisest and wealthiest man to ever live, he didn’t finish strong. God gave him many blessings, but Solomon took them for granted and allowed the people around him to lead him away from God. Are you on track to finish strong? Are the people around you helping you get closer to God or pushing you farther away from Him?" },
    { "type": "textarea", "id": "sample_prayer", "label": "Prayer", "default": "Lord, help me be grateful for all the help You’ve given me. Thank You for the wisdom of Your Word. Bring that wisdom to life in me today, and bring good and godly influences into my life to help me along the path You’ve set before me. In Jesus’ name. Amen." },
    { "type": "text", "id": "sample_audio", "label": "Audio detail", "default": "Audio version available" },
    { "type": "text", "id": "sample_reading", "label": "Reading plan detail", "default": "1 Chron 25–26 · Acts 19:8–24 · Ps 87 · Prov 18:10–11" },
    { "type": "text", "id": "sample_source", "label": "Source note", "default": "Cached from Day 205 on TheBibleBand.com." },
    { "type": "header", "content": "Give one, share one" },
    { "type": "checkbox", "id": "enable_share_offer", "label": "Enable offer", "default": true },
    { "type": "text", "id": "share_heading", "label": "Heading", "default": "Give one, share one" },
    { "type": "textarea", "id": "share_copy", "label": "Description", "default": "Get two bands—one to wear and one to give—with gift-ready packaging for the one you share, included free." },
    { "type": "text", "id": "share_badge", "label": "Badge", "default": "Free gift packaging" },
    { "type": "header", "content": "Social sharing" },
    { "type": "checkbox", "id": "enable_social_share", "label": "Show social share buttons", "default": true }
  ]
}
{% endschema %}

{% stylesheet %}
  .daily-preview{padding:clamp(75px,9vw,130px) 0;background:var(--cream);color:var(--ink);overflow:hidden}
  .daily-preview__layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(420px,1.15fr);gap:clamp(50px,8vw,120px);align-items:center}
  .daily-preview__intro .display-title{max-width:720px;margin-bottom:28px;font-size:clamp(50px,6.5vw,96px)}
  .daily-preview__intro>p{max-width:590px;font-size:clamp(17px,1.5vw,20px);line-height:1.7}
  .daily-preview__included{display:flex;flex-wrap:wrap;gap:9px;margin-top:32px}
  .daily-preview__included span{padding:9px 12px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase}
  .daily-preview__device{width:min(100%,520px);justify-self:center;padding:12px;border:2px solid var(--ink);border-radius:34px;background:var(--ink);box-shadow:14px 18px 0 var(--gold)}
  .daily-preview__card{overflow:hidden;background:#fffdf8;border-radius:23px}
  .daily-preview__app-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 22px;background:var(--ink);color:var(--cream)}
  .daily-preview__brand{display:flex;align-items:center;gap:9px;font-size:13px;text-transform:uppercase}.daily-preview__brand>span{color:var(--gold);font-size:18px}.daily-preview__day{font-size:9px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .daily-preview__progress{height:5px;background:#2c2823}.daily-preview__progress span{display:block;width:56.2%;height:100%;background:var(--gold)}
  .daily-preview__welcome{padding:26px 25px 20px}.daily-preview__welcome>span,.daily-preview__welcome>p{display:block;margin:0;color:var(--rust);font-size:9px;font-weight:950;letter-spacing:1.4px;text-transform:uppercase}.daily-preview__welcome>p{margin-top:6px;color:var(--brown)}.daily-preview__welcome h3{margin:9px 0 0;font-family:var(--font-heading);font-size:clamp(34px,5vw,54px);letter-spacing:-.035em;line-height:.95}
  .daily-preview__verse-card{margin:0 18px;padding:23px;border-radius:16px;background:var(--rust);color:var(--cream)}.daily-preview__label{display:block;color:var(--gold);font-size:9px;font-weight:950;letter-spacing:1.5px;text-transform:uppercase}.daily-preview__verse-card blockquote{margin:12px 0 10px;font-family:var(--font-heading);font-size:clamp(25px,3vw,34px);font-style:italic;line-height:1.12}.daily-preview__verse-card cite{font-size:10px;font-style:normal;font-weight:950;letter-spacing:1px;text-transform:uppercase}
  .daily-preview__section{margin:0 25px;padding:25px 0;border-bottom:1px solid #d9ccbb}.daily-preview__section-head{display:flex;align-items:center;gap:11px}.daily-preview__number{display:flex;width:29px;height:29px;align-items:center;justify-content:center;border:1px solid var(--rust);border-radius:50%;color:var(--rust);font-size:8px;font-weight:950}.daily-preview__section h4{margin:0;font-size:12px;letter-spacing:1.3px;text-transform:uppercase}.daily-preview__section p{margin:13px 0 0;color:#3d372f;font-size:14px;line-height:1.68}.daily-preview__prayer p{font-style:italic}
  .daily-preview__extras{display:grid;gap:9px;padding:20px 18px;background:#f2e7d8}.daily-preview__extra{display:flex;align-items:center;gap:12px;padding:13px 14px;border:1px solid #d4c4b0;border-radius:11px;background:#fffdf8}.daily-preview__extra>span:last-child{display:flex;flex-direction:column;gap:3px}.daily-preview__extra strong{font-size:10px;letter-spacing:.7px;text-transform:uppercase}.daily-preview__extra small{color:var(--brown);font-size:10px}.daily-preview__play,.daily-preview__book{display:flex;width:31px;height:31px;align-items:center;justify-content:center;flex:none;border-radius:50%;background:var(--ink);color:var(--gold);font-size:9px}.daily-preview__book{font-family:serif;font-size:17px}
  .daily-preview__card footer{padding:15px 20px;background:var(--ink);color:#c8bfb5;font-size:8px;font-weight:800;letter-spacing:.7px;line-height:1.5;text-transform:uppercase}.daily-preview__cached{display:inline-block;margin-right:8px;padding:4px 6px;border:1px solid var(--gold);color:var(--gold);font-size:7px;letter-spacing:1px}
  @media(max-width:900px){.daily-preview__layout{grid-template-columns:1fr}.daily-preview__device{justify-self:start;margin-right:14px}}
  @media(max-width:640px){.daily-preview__device{padding:8px;border-radius:28px;box-shadow:9px 11px 0 var(--gold)}.daily-preview__card{border-radius:19px}.daily-preview__app-head{padding:16px 18px}.daily-preview__welcome{padding:22px 20px 17px}.daily-preview__section{margin-inline:20px}}
{% endstylesheet %}
