{% liquid
  assign is_bible_band = false
  if product.handle == 'the-bible-band'
    assign is_bible_band = true
  endif
  assign product_form_id = 'ProductForm-' | append: section.id
  assign gallery_limit = 8
  assign gallery_count = product.media.size | at_most: gallery_limit
  assign demo_media = blank
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign demo_media = media
      break
    endif
  endfor
%}
<section class="product-page page-width">
  <div class="product-layout">
    <div class="product-media-column">
      <div class="product-gallery-wrap" data-product-gallery>
        <div class="product-gallery" data-product-gallery-track>
          {% for media in product.media limit: gallery_limit %}<div class="product-gallery__item" data-product-gallery-slide data-media-id="{{ media.id }}">{% if media.media_type == 'image' %}{{ media | image_url: width: 1600 | image_tag: widths: '400,700,1000,1600', loading: 'lazy', alt: media.alt | default: product.title }}{% else %}{{ media | media_tag: image_size: '1600x' }}{% endif %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endfor %}
        </div>
        {% if gallery_count > 1 %}
          <div class="product-gallery__controls">
            <button class="product-gallery__button" type="button" data-gallery-previous aria-label="{{ 'products.gallery.previous' | t }}">&larr;</button>
            <p class="product-gallery__counter" aria-live="polite"><span data-gallery-current>1</span> / {{ gallery_count }}</p>
            <button class="product-gallery__button" type="button" data-gallery-next aria-label="{{ 'products.gallery.next' | t }}">&rarr;</button>
          </div>
        {% endif %}
      </div>
      <div class="product-details">
        {% if is_bible_band %}
          <div class="band-at-a-glance">
            <span class="eyebrow">{{ 'products.bible_band.at_a_glance' | t }}</span>
            <div class="band-at-a-glance__items" aria-label="{{ 'products.bible_band.included_label' | t }}">
              <span>{{ 'products.bible_band.scripture_label' | t }}</span><span>{{ 'products.bible_band.devotion_label' | t }}</span><span>{{ 'products.bible_band.prayer_label' | t }}</span><span>{{ 'products.bible_band.audio_label' | t }}</span><span>{{ 'products.bible_band.plan_label' | t }}</span>
            </div>
          </div>
          <div class="product-meta">
            <details><summary>{{ 'products.bible_band.details_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.details_copy' | t }}</p></div></details>
            <details><summary>{{ 'products.bible_band.compatibility_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.compatibility_copy' | t }}</p></div></details>
            <details><summary>{{ 'products.bible_band.shipping_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.shipping_copy' | t }}</p></div></details>
          </div>
        {% else %}
          <div class="rte">{{ product.description }}</div>
          <div class="product-meta"><details><summary>Shipping &amp; delivery</summary><div class="rte"><p>Shipping and delivery options are shown at checkout. Digital products are delivered according to their product description.</p></div></details><details><summary>Questions?</summary><div class="rte"><p>Visit our FAQ or contact Bible House Goods and we'll be glad to help.</p></div></details></div>
        {% endif %}
      </div>
    </div>
    <div class="product-info">
      {% if product.vendor != blank %}<span class="eyebrow">{{ product.vendor }}</span>{% endif %}
      <h1>{% if is_bible_band %}{{ 'products.bible_band.short_title' | t }}{% else %}{% render 'trademark-title', title: product.title %}{% endif %}</h1>
      <div class="product-rating-summary">
        {% render 'judgeme-star-rating', product: product %}
        <a href="#judgeme_product_reviews">{{ 'general.social_proof.judgeme_link' | t }}</a>
      </div>
      <p class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      {% if settings.social_etsy_url != blank and is_bible_band == false %}
        <a class="product-review-link" href="{{ settings.social_etsy_url }}" target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span> Read customer reviews on Etsy ↗</a>
      {% endif %}
      {% if is_bible_band %}
        <div class="quiet-time-solution">
          <span class="eyebrow">{{ 'products.bible_band.problem_kicker' | t }}</span>
          <h2>{{ section.settings.problem_heading }}</h2>
          <p>{{ section.settings.problem_copy }}</p>
        </div>
      {% endif %}
      {% if is_bible_band and section.settings.show_demo_video %}
        <aside class="tap-demo tap-demo--early" aria-labelledby="TapDemoTitle-{{ section.id }}">
          <div class="tap-demo__heading">
            <span class="eyebrow">{{ 'products.bible_band.tap_demo_kicker' | t }}</span>
            <h2 id="TapDemoTitle-{{ section.id }}">{{ 'products.bible_band.tap_demo_heading' | t }}</h2>
            <p>{{ 'products.bible_band.tap_demo_copy' | t }}</p>
          </div>
          <div class="tap-demo__media" data-tap-demo data-demo-duration="5">
            {% if section.settings.demo_video != blank %}
              {{ section.settings.demo_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
            {% elsif demo_media != blank %}
              {{ demo_media | media_tag: autoplay: true, loop: true, muted: true, controls: true }}
            {% else %}
              <div class="tap-demo__placeholder"><span>{{ 'products.bible_band.tap_demo_tap' | t }}</span><strong>{{ 'products.bible_band.tap_demo_scripture' | t }}</strong><small>{{ 'products.bible_band.tap_demo_no_app' | t }}</small></div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
      {% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% unless product.has_only_default_variant %}
          <div>
            <label class="field-label{% if is_bible_band %} field-label--band-choice{% endif %}" for="Variant-{{ section.id }}">
              {% if is_bible_band %}{{ 'products.bible_band.choose_band' | t }}{% else %}Choose an option{% endif %}
            </label>
            <select id="Variant-{{ section.id }}" data-variant-select data-product-title="{{ product.title | escape }}">{% for variant in product.variants %}{% assign is_preorder = false %}{% if variant.option2 == 'Cobalt Blue / Grey Aztec' or variant.option2 == 'Space Grey / Sport Grey' or variant.option2 == 'Pink Bubblegum / Bubblegum Check' or variant.option2 == 'Maroon / Maroon Aztec' %}{% assign is_preorder = true %}{% endif %}<option value="{{ variant.id }}" data-available="{{ variant.available }}" data-preorder="{{ is_preorder }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" data-variant-title="{{ variant.title | escape }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}>{{ variant.title }}{% if is_preorder %} — Preorder{% elsif variant.available == false %} — Sold out{% endif %}</option>{% endfor %}</select>
          </div>
        {% endunless %}
        {% if is_bible_band %}
          <fieldset class="band-tiers" data-band-tiers>
            <legend class="field-label">{{ 'products.bible_band.quantity_heading' | t }}</legend>
            <label class="band-tier">
              <input type="radio" name="band-tier" value="1" checked data-band-tier>
              <span><strong>{{ 'products.bible_band.tier_one' | t }}</strong><small>{{ 'products.bible_band.tier_one_note' | t }}</small></span>
              <b>{{ 'products.bible_band.tier_one_price' | t }}</b>
            </label>
            <label class="band-tier">
              <input type="radio" name="band-tier" value="2" data-band-tier>
              <span><strong>{{ 'products.bible_band.tier_two' | t }}</strong><small>{{ 'products.bible_band.tier_two_note' | t }}</small></span>
              <b>{{ 'products.bible_band.tier_two_price' | t }}</b>
            </label>
            <label class="band-tier">
              <input type="radio" name="band-tier" value="3" data-band-tier>
              <span><strong>{{ 'products.bible_band.tier_three' | t }}</strong><small>{{ 'products.bible_band.tier_three_note' | t }}</small></span>
              <b>{{ 'products.bible_band.tier_three_price' | t }}</b>
            </label>
            <label class="band-tier">
              <input type="radio" name="band-tier" value="4" data-band-tier>
              <span><strong>{{ 'products.bible_band.tier_four' | t }}</strong><small>{{ 'products.bible_band.tier_four_note' | t }}</small></span>
              <b>{{ 'products.bible_band.tier_four_price' | t }}</b>
            </label>
            <p class="band-tiers__note">{{ 'products.bible_band.quantity_note' | t }}</p>
          </fieldset>
        {% endif %}
        {% if is_bible_band %}
          <input id="Quantity-{{ section.id }}" type="hidden" name="quantity" value="1" data-band-quantity>
        {% else %}
          <div><label class="field-label" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"></div>
        {% endif %}
        {% assign selected_is_preorder = false %}
        {% if product.selected_or_first_available_variant.option2 == 'Cobalt Blue / Grey Aztec' or product.selected_or_first_available_variant.option2 == 'Space Grey / Sport Grey' or product.selected_or_first_available_variant.option2 == 'Pink Bubblegum / Bubblegum Check' or product.selected_or_first_available_variant.option2 == 'Maroon / Maroon Aztec' %}
          {% assign selected_is_preorder = true %}
        {% endif %}
        <button class="button" type="submit" data-primary-product-submit data-product-title="{{ product.title | escape }}"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if selected_is_preorder %}Preorder{% elsif product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
        {% if is_bible_band %}
          <ul class="purchase-reassurance" aria-label="Purchase reassurance">
            <li><strong>Free shipping</strong><span>on Bible Band orders</span></li>
            <li><strong>No app</strong><span>tap and open</span></li>
            <li><strong>No subscription</strong><span>ever</span></li>
            <li><strong>Compatible</strong><span>iPhone &amp; Android</span></li>
            <li><strong>Delivery</strong><span>typically 3–7 business days</span></li>
            <li><strong>Easy returns</strong><span>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">View return policy</a>{% else %}Contact us for help{% endif %}</span></li>
          </ul>
          <p class="login-disclaimer"><strong>Optional login:</strong> No login is required to open the daily content. Sign in only if you want to track streaks and Bible reading plan progress.</p>
          <p class="product-impact"><span aria-hidden="true">✦</span><strong>Your Bible Band™ gives back.</strong> A portion of all profits supports local church ministry and missions.</p>
        {% endif %}
        {{ form | payment_button }}
        {% render 'payment-options' %}
      {% endform %}
      {% if section.settings.enable_social_share and is_bible_band == false %}{% render 'product-share', product: product, share_url: canonical_url %}{% endif %}
    </div>
  </div>
</section>

{% if is_bible_band %}
  <section class="featured-reviews" aria-labelledby="FeaturedReviews-{{ section.id }}">
    <div class="page-width">
      <div class="featured-reviews__head">
        <div><span class="eyebrow">{{ 'general.social_proof.judgeme_label' | t }}</span><h2 id="FeaturedReviews-{{ section.id }}">{{ 'products.bible_band.review_heading' | t }}</h2></div>
        {% render 'judgeme-star-rating', product: product %}
      </div>
      <div class="featured-reviews__grid">
        {% for i in (1..3) %}
          {% liquid
            assign quote_key = 'review_quote_' | append: i
            assign author_key = 'review_author_' | append: i
            assign image_key = 'review_image_' | append: i
            assign review_image = section.settings[image_key]
            if review_image == blank
              if i == 1
                assign review_image = product.images[0]
              elsif i == 2
                assign review_image = product.images[4]
              else
                assign review_image = product.images[21]
              endif
              assign review_image = review_image | default: product.featured_image
            endif
          %}
          <article class="featured-review">
            <div class="featured-review__image">
              {{ review_image | image_url: width: 900 | image_tag: widths: '320,520,720,900', loading: 'lazy', alt: product.title }}
              <span>{% if section.settings[image_key] != blank %}{{ 'products.bible_band.customer_photo' | t }}{% else %}{{ 'products.bible_band.lifestyle_photo' | t }}{% endif %}</span>
            </div>
            <div class="featured-review__copy"><span aria-hidden="true">★★★★★</span><blockquote>“{{ section.settings[quote_key] }}”</blockquote><cite>— {{ section.settings[author_key] }}</cite></div>
          </article>
        {% endfor %}
      </div>
      <a class="featured-reviews__link" href="#judgeme_product_reviews">{{ 'general.social_proof.judgeme_link' | t }} ↓</a>
    </div>
  </section>

  <section class="mark-testimonial" aria-labelledby="MarkTestimonial-{{ section.id }}">
    <div class="page-width mark-testimonial__layout">
      <div class="mark-testimonial__image">
        {% if section.settings.mark_testimonial_image != blank %}
          {{ section.settings.mark_testimonial_image | image_url: width: 1200 | image_tag: widths: '360,560,760,1000,1200', loading: 'lazy', alt: section.settings.mark_testimonial_name }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0966/1972/4984/files/mark-hatley-bible-band-testimonial.jpg?v=1785633674" loading="lazy" width="960" height="960" alt="{{ section.settings.mark_testimonial_name | escape }}">
        {% endif %}
      </div>
      <div class="mark-testimonial__copy">
        <span class="eyebrow">{{ 'products.bible_band.customer_story' | t }}</span>
        <span class="mark-testimonial__stars" aria-label="5 out of 5 stars">★★★★★</span>
        <blockquote id="MarkTestimonial-{{ section.id }}">“{{ section.settings.mark_testimonial_quote }}”</blockquote>
        <p class="mark-testimonial__person"><strong>{{ section.settings.mark_testimonial_name }}</strong><span>{{ section.settings.mark_testimonial_location }}</span></p>
        <a href="#judgeme_product_reviews">{{ 'products.bible_band.full_testimonial_link' | t }} ↓</a>
      </div>
    </div>
  </section>
{% endif %}

<div class="mobile-purchase-bar" data-mobile-purchase-bar>
  <div>
    <strong>{% if is_bible_band %}The Bible Band™{% else %}{{ product.title }}{% endif %}</strong>
    <span data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>
  </div>
  <button class="button button--gold" type="button" data-sticky-add aria-controls="{{ product_form_id }}"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
    {% if selected_is_preorder %}Preorder{% elsif product.selected_or_first_available_variant.available %}{% if is_bible_band %}Get Your Bible Band{% else %}Add to Cart{% endif %}{% else %}Sold out{% endif %}
  </button>
</div>

{% if product.handle == 'the-bible-band' and section.settings.show_bible_band_sections %}
  <section class="dark-section">
    <div class="page-width">
      <span class="eyebrow">{{ 'products.bible_band.how_it_works' | t }}</span>
      <h2 class="section-title">{{ 'products.bible_band.discipleship_title' | t }}</h2>
      <div class="steps-grid">
        <div class="step"><div class="step__number">1</div><h3>{{ 'products.bible_band.wear_title' | t }}</h3><p>{{ 'products.bible_band.wear_copy' | t }}</p></div>
        <div class="step"><div class="step__number">2</div><h3>{{ 'products.bible_band.tap_title' | t }}</h3><p>{{ 'products.bible_band.tap_copy' | t }}</p></div>
        <div class="step"><div class="step__number">3</div><h3>{{ 'products.bible_band.read_title' | t }}</h3><p>{{ 'products.bible_band.read_copy' | t }}</p></div>
      </div>
      <div class="product-guide-cta">
        <a class="button button--gold" href="{{ pages['how-to-use-your-bible-band'].url | default: '/pages/how-to-use-your-bible-band' }}">{{ 'products.bible_band.guide_link' | t }}</a>
      </div>
    </div>
  </section>

  <section class="daily-preview" aria-labelledby="ProductDailyPreview-{{ section.id }}">
    <div class="page-width daily-preview__layout">
      <div class="daily-preview__intro">
        <span class="eyebrow">{{ section.settings.sample_kicker }}</span>
        <h2 class="display-title" id="ProductDailyPreview-{{ section.id }}">{{ section.settings.sample_heading }}</h2>
        <p>{{ section.settings.sample_intro }}</p>
        <div class="daily-preview__included" aria-label="{{ 'products.bible_band.included_label' | t }}">
          <span>{{ 'products.bible_band.scripture_label' | t }}</span><span>{{ 'products.bible_band.devotion_label' | t }}</span><span>{{ 'products.bible_band.prayer_label' | t }}</span><span>{{ 'products.bible_band.audio_label' | t }}</span><span>{{ 'products.bible_band.plan_label' | t }}</span>
        </div>
        <a class="button" href="https://thebibleband.com" target="_blank" rel="noopener">{{ 'products.bible_band.preview_button' | t }} ↗</a>
      </div>
      <div class="daily-preview__device">
        {{ 'bible-band-sample-day.png' | asset_url | image_tag: loading: 'lazy', alt: section.settings.sample_heading }}
      </div>
    </div>
  </section>
{% endif %}

{% render 'judgeme-review-widget', product: product %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_bible_band_sections", "label": "Show Bible Band discipleship sections", "default": true },
    { "type": "header", "content": "Proof and tap demonstration" },
    { "type": "text", "id": "problem_heading", "label": "Problem and solution heading", "default": "A rhythm you can remember" },
    { "type": "textarea", "id": "problem_copy", "label": "Problem and solution copy", "default": "Quiet time is easy to plan—and easy to forget. The Bible Band keeps a simple reminder on your wrist: notice it, tap it, and today’s Scripture, devotion, and prayer are ready." },
    { "type": "checkbox", "id": "show_demo_video", "label": "Show tap demonstration", "default": true },
    { "type": "video", "id": "demo_video", "label": "3–5 second tap demonstration", "info": "Upload a short, muted clip showing a phone tapping the band and opening the daily experience." },
    { "type": "header", "content": "Featured Bible Band reviews" },
    { "type": "textarea", "id": "review_quote_1", "label": "Review 1", "default": "Love this product and the camo design! It’s such an easy way to stay consistent with Scripture reading and devotion." },
    { "type": "text", "id": "review_author_1", "label": "Review 1 name", "default": "Bible Band customer" },
    { "type": "image_picker", "id": "review_image_1", "label": "Review 1 customer photo" },
    { "type": "textarea", "id": "review_quote_2", "label": "Review 2", "default": "This is the easiest way to get daily encouragement through the Word of God!" },
    { "type": "text", "id": "review_author_2", "label": "Review 2 name", "default": "Gina" },
    { "type": "image_picker", "id": "review_image_2", "label": "Review 2 customer photo" },
    { "type": "textarea", "id": "review_quote_3", "label": "Review 3", "default": "I got a good devotional, prayer and scripture. I highly recommend it!" },
    { "type": "text", "id": "review_author_3", "label": "Review 3 name", "default": "Arlene" },
    { "type": "image_picker", "id": "review_image_3", "label": "Review 3 customer photo" },
    { "type": "header", "content": "Mark Hatley testimonial" },
    { "type": "image_picker", "id": "mark_testimonial_image", "label": "Mark's photo" },
    { "type": "textarea", "id": "mark_testimonial_quote", "label": "Featured excerpt", "default": "What can I say about the Bible Band except that, in my opinion, it's about as close to perfect as you can get. … With one tap using your smartphone, you're taken directly to Scripture, a daily devotional, and prayer. It only takes a few minutes each day, but the time you invest can have a lasting impact. … It has genuinely enriched my daily Bible reading, prayer time, and personal walk with the Lord." },
    { "type": "text", "id": "mark_testimonial_name", "label": "Name", "default": "Mark Hatley" },
    { "type": "text", "id": "mark_testimonial_location", "label": "Location", "default": "Bernice, LA" },
    { "type": "header", "content": "Cached daily devotion sample" },
    { "type": "text", "id": "sample_kicker", "label": "Kicker", "default": "See What One Tap Opens" },
    { "type": "text", "id": "sample_heading", "label": "Heading", "default": "A Real Daily Devotion" },
    { "type": "textarea", "id": "sample_intro", "label": "Introduction", "default": "This static sample from TheBibleBand.com shows the kind of Scripture, pastor-written reflection, and guided prayer your band opens each day." },
    { "type": "header", "content": "Social sharing" },
    { "type": "checkbox", "id": "enable_social_share", "label": "Show social share buttons", "default": true }
  ]
}
{% endschema %}

{% stylesheet %}
  .featured-reviews{padding:clamp(64px,8vw,110px) 0;background:var(--tan);color:var(--ink)}
  .featured-reviews__head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:34px}.featured-reviews__head h2{margin:8px 0 0;font-size:clamp(40px,6vw,78px);letter-spacing:-.05em;line-height:.92;text-transform:uppercase}
  .featured-reviews__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.featured-review{display:flex;min-width:0;flex-direction:column;background:var(--cream);border:2px solid var(--ink)}.featured-review__image{position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--brown)}.featured-review__image img{width:100%;height:100%;object-fit:cover}.featured-review__image>span{position:absolute;right:8px;bottom:8px;padding:6px 8px;background:var(--ink);color:var(--cream);font-size:8px;font-weight:900;letter-spacing:1px;text-transform:uppercase}.featured-review__copy{display:flex;flex:1;flex-direction:column;padding:22px}.featured-review__copy>span{color:var(--rust);font-size:13px;letter-spacing:2px}.featured-review blockquote{margin:12px 0 20px;font-size:16px;font-weight:750;line-height:1.55}.featured-review cite{margin-top:auto;font-size:10px;font-style:normal;font-weight:900;letter-spacing:1px;text-transform:uppercase}.featured-reviews__link{display:inline-block;margin-top:24px;font-size:11px;font-weight:950;letter-spacing:1px;text-transform:uppercase;text-underline-offset:5px}
  .band-at-a-glance{padding-top:22px}.band-at-a-glance__items{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.band-at-a-glance__items span{padding:9px 11px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1px;text-transform:uppercase}
  .mark-testimonial{padding:clamp(58px,7vw,96px) 0;background:var(--ink);color:var(--cream);border-block:2px solid var(--ink)}.mark-testimonial__layout{display:grid;grid-template-columns:minmax(300px,.72fr) minmax(0,1.28fr);gap:clamp(34px,7vw,96px);align-items:center}.mark-testimonial__image{overflow:hidden;aspect-ratio:1/1;border:2px solid var(--gold);box-shadow:12px 12px 0 var(--rust)}.mark-testimonial__image img{width:100%;height:100%;object-fit:cover}.mark-testimonial__copy .eyebrow{color:var(--gold)}.mark-testimonial__stars{display:block;color:var(--gold);font-size:16px;letter-spacing:3px}.mark-testimonial blockquote{max-width:850px;margin:18px 0 26px;font-family:var(--font-heading);font-size:clamp(27px,3.2vw,48px);font-weight:850;letter-spacing:-.035em;line-height:1.08}.mark-testimonial__person{display:flex;flex-direction:column;gap:5px;margin:0}.mark-testimonial__person strong{font-size:14px;letter-spacing:1px;text-transform:uppercase}.mark-testimonial__person span{color:var(--tan);font-size:12px}.mark-testimonial__copy>a{display:inline-block;margin-top:24px;color:var(--gold);font-size:10px;font-weight:950;letter-spacing:1px;text-transform:uppercase;text-underline-offset:5px}
  .product-guide-cta{display:flex;justify-content:center;margin-top:36px}
  .daily-preview{padding:clamp(64px,8vw,100px) 0;background:var(--cream);color:var(--ink);overflow:hidden}
  .daily-preview__layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(380px,1.2fr);gap:clamp(42px,7vw,100px);align-items:center}
  .daily-preview__intro .display-title{max-width:620px;margin-bottom:22px;font-size:clamp(46px,6vw,82px)}.daily-preview__intro>p{max-width:520px;font-size:18px;line-height:1.65}
  .daily-preview__included{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.daily-preview__included span{padding:9px 12px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase}.daily-preview__intro .button{margin-top:26px}
  .daily-preview__device{width:min(100%,680px);justify-self:center}.daily-preview__device img{display:block;width:100%;height:auto;border:2px solid var(--ink);box-shadow:12px 14px 0 var(--gold)}
  @media(max-width:900px){.featured-reviews__grid{grid-template-columns:1fr 1fr}.featured-review:last-child{grid-column:1/-1}.mark-testimonial__layout,.daily-preview__layout{grid-template-columns:1fr}.mark-testimonial__image{width:min(100%,560px)}.daily-preview__device{justify-self:start;margin-right:14px}}
  @media(max-width:640px){.featured-reviews{padding-block:54px}.featured-reviews__head{display:grid;margin-bottom:24px}.featured-reviews__grid{display:flex;margin-right:-14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-right:14px}.featured-review{min-width:82vw;scroll-snap-align:start}.featured-review:last-child{grid-column:auto}.featured-review__copy{padding:18px}.featured-review blockquote{font-size:14px}.mark-testimonial{padding-block:48px}.mark-testimonial__layout{gap:32px}.mark-testimonial__image{width:calc(100% - 8px);box-shadow:8px 8px 0 var(--rust)}.mark-testimonial blockquote{font-size:27px;line-height:1.12}.daily-preview__intro .display-title{font-size:46px}.daily-preview__device img{box-shadow:8px 9px 0 var(--gold)}}
