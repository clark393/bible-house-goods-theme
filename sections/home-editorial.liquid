  @media(max-width:760px){.community-proof__head{grid-template-columns:1fr}.community-proof__actions{justify-content:flex-start}.community-proof__rail{display:flex;width:calc(100% + 14px);padding:0 14px 10px 0;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.community-proof__rail::-webkit-scrollbar{display:none}.social-post,.review-card{flex:0 0:min(84vw,340px);scroll-snap-align:start}.review-card{min-height:340px}}
