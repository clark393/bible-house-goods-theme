<section class="hero">
  <div class="page-width">
    <span class="eyebrow">{{ section.settings.kicker }}</span>
    <div class="hero__grid">
      <div class="hero__content">
        <h1 class="display-title">{{ section.settings.heading }}</h1>
        <div class="hero__copy">
          <p>{{ section.settings.copy }}</p>
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-analytics-event="hero_cta_click" data-analytics-label="{{ section.settings.button_label | escape }}">{{ section.settings.button_label }}</a>
          <div class="hero__proof" aria-label="Product testimonial">
            <span aria-hidden="true">★★★★★</span>
            <p>“{{ section.settings.hero_testimonial }}” <strong>— {{ section.settings.hero_testimonial_cite }}</strong></p>
          </div>
        </div>
        <div class="hero__features">
          {% assign feature_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              {% assign feature_index = feature_index | plus: 1 %}
              <div class="hero-feature" {{ block.shopify_attributes }}>
                <div class="hero-feature__number">0{{ feature_index }}</div>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.copy }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="hero__media">
        {% if section.settings.hero_video != blank %}
          {%- liquid
            assign video_poster = section.settings.hero_video_poster
            if video_poster == blank
              assign video_poster = section.settings.hero_image
            endif
            if video_poster == blank and section.settings.featured_product != blank
              assign video_poster = section.settings.featured_product.featured_image
            endif
            if video_poster != blank
              assign video_poster_url = video_poster | image_url: width: 2000
            endif
          -%}
          {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', poster: video_poster_url, image_size: '2000x' }}
        {% elsif section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: widths: '500,750,1000,1400', fetchpriority: 'high', alt: section.settings.hero_image.alt | default: section.settings.heading }}
        {% elsif section.settings.featured_product != blank and section.settings.featured_product.featured_image != blank %}
          {{ section.settings.featured_product.featured_image | image_url: width: 1400 | image_tag: widths: '500,750,1000,1400', fetchpriority: 'high', alt: section.settings.featured_product.title }}
        {% else %}<span>Add a Bible Band™ image</span>{% endif %}
      </div>
    </div>
  </div>
</section>

{% if section.settings.featured_product != blank %}
  <section class="band-shop" aria-labelledby="BandShopTitle-{{ section.id }}">
    <div class="page-width">
      <span class="eyebrow">Choose Your Bible Band™</span>
      <h2 class="section-title" id="BandShopTitle-{{ section.id }}">Six Bands. One Daily Habit.</h2>
      <div class="band-shop__grid">
        {% assign seen_band_colors = '|' %}
        {% for variant in section.settings.featured_product.variants %}
          {% assign band_color = variant.option2 | default: variant.title %}
          {% assign band_color_key = '|' | append: band_color | append: '|' %}
          {% unless seen_band_colors contains band_color_key %}
            {% assign seen_band_colors = seen_band_colors | append: band_color | append: '|' %}
            <a class="band-shop__card" href="{{ section.settings.featured_product.url }}?variant={{ variant.id }}" data-analytics-event="product_option_selected" data-product-title="{{ section.settings.featured_product.title | escape }}" data-variant-title="{{ band_color | escape }}">
              <div class="band-shop__image">
                {% if variant.featured_image != blank %}
                  {{ variant.featured_image | image_url: width: 900 | image_tag: widths: '300,500,700,900', loading: 'lazy', alt: band_color }}
                {% else %}
                  {{ section.settings.featured_product.featured_image | image_url: width: 900 | image_tag: widths: '300,500,700,900', loading: 'lazy', alt: band_color }}
                {% endif %}
              </div>
              <div class="band-shop__info">
                <h3>{{ band_color }}</h3>
                <span>{% if band_color == 'Cobalt Blue / Grey Aztec' or band_color == 'Space Grey / Sport Grey' or band_color == 'Pink Bubblegum / Bubblegum Check' or band_color == 'Maroon / Maroon Aztec' %}Preorder{% else %}Shop now{% endif %} →</span>
              </div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

<section class="products-section products-section--priority">
  <div class="page-width">
    <div class="section-head"><h2 class="section-title">{{ section.settings.products_heading }}</h2><a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">View all →</a></div>
    <div class="product-grid">
      {% assign source_collection = section.settings.collection | default: collections.all %}
      {% assign displayed_products = 0 %}
      {% if section.settings.featured_product != blank %}
        {% render 'product-card', product: section.settings.featured_product %}
        {% assign displayed_products = 1 %}
      {% endif %}
      {% for product in source_collection.products %}
        {% if section.settings.featured_product == blank or product.id != section.settings.featured_product.id %}
          {% render 'product-card', product: product %}
          {% assign displayed_products = displayed_products | plus: 1 %}
        {% endif %}
        {% if displayed_products >= 4 %}{% break %}{% endif %}
      {% else %}
        {% if section.settings.featured_product == blank %}<p>Your products will appear here automatically.</p>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% assign social_proof_count = 0 %}
{% for block in section.blocks %}
  {% if block.type == 'social_post' or block.type == 'review' %}
    {% assign social_proof_count = social_proof_count | plus: 1 %}
  {% endif %}
{% endfor %}
{% if social_proof_count > 0 %}
  <section class="community-proof" aria-labelledby="CommunityProofTitle-{{ section.id }}">
    <div class="page-width">
      <div class="community-proof__head">
        <div>
          <span class="eyebrow">{{ section.settings.social_kicker }}</span>
          <h2 class="section-title" id="CommunityProofTitle-{{ section.id }}">{{ section.settings.social_heading }}</h2>
          <p>{{ section.settings.social_copy }}</p>
        </div>
        <div class="community-proof__actions">
          {% if settings.social_tiktok_url != blank %}<a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener">Follow on TikTok ↗</a>{% endif %}
          {% if settings.social_etsy_url != blank %}<a href="{{ settings.social_etsy_url }}" target="_blank" rel="noopener">Read Etsy reviews ↗</a>{% endif %}
        </div>
      </div>
      <div class="community-proof__rail">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'social_post' %}
              <article class="social-post" {{ block.shopify_attributes }}>
                <div class="social-post__media">
                  {% if block.settings.video != blank %}
                    {{ block.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
                  {% elsif block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption }}
                  {% else %}
                    <div class="social-post__placeholder"><span>Play</span><strong>{{ block.settings.platform }}</strong></div>
                  {% endif %}
                  <span class="social-post__platform">{{ block.settings.platform }}</span>
                </div>
                <p>{{ block.settings.caption }}</p>
                {% assign social_post_link = block.settings.link | default: settings.social_tiktok_url %}
                {% if social_post_link != blank %}<a class="social-post__link" href="{{ social_post_link }}" target="_blank" rel="noopener">Watch the post ↗</a>{% endif %}
              </article>
            {% when 'review' %}
              <article class="review-card" {{ block.shopify_attributes }}>
                <div class="review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for star in (1..5) %}<span aria-hidden="true">{% if star <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
                </div>
                <blockquote>“{{ block.settings.quote }}”</blockquote>
                <footer>
                  <strong>{{ block.settings.author }}</strong>
                  <span>{{ block.settings.source }}</span>
                  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="View review by {{ block.settings.author | escape }}">View review ↗</a>{% endif %}
                </footer>
              </article>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

<section class="dark-section">
  <div class="page-width">
    <span class="eyebrow">How it works</span><h2 class="section-title">Simple Daily Discipleship</h2>
    <div class="steps-grid">
      <div class="step"><div class="step__number">1</div><h3>Wear It</h3><p>Put on your Bible Band™ as a daily reminder.</p></div>
      <div class="step"><div class="step__number">2</div><h3>Tap It</h3><p>Your compatible phone opens today's content.</p></div>
      <div class="step"><div class="step__number">3</div><h3>Read &amp; Pray</h3><p>Scripture, devotion, prayer, audio, and a Bible reading plan.</p></div>
    </div>
  </div>
</section>

<section class="daily-preview" aria-labelledby="daily-preview-title">
  <div class="page-width daily-preview__layout">
    <div class="daily-preview__intro">
      <span class="eyebrow">{{ section.settings.preview_kicker }}</span>
      <h2 class="display-title" id="daily-preview-title">{{ section.settings.preview_heading }}</h2>
      <p>{{ section.settings.preview_intro }}</p>
      <div class="daily-preview__included" aria-label="{{ section.settings.preview_includes_label | escape }}">
        <span>{{ section.settings.preview_scripture_label }}</span>
        <span>{{ section.settings.preview_devotion_label }}</span>
        <span>{{ section.settings.preview_prayer_label }}</span>
        <span>{{ section.settings.preview_audio_label }}</span>
        <span>{{ section.settings.preview_plan_label }}</span>
      </div>
    </div>

    <article class="daily-preview__card">
      <header class="daily-preview__card-head">
        <div>
          <span class="daily-preview__sample-label">{{ section.settings.preview_sample_label }}</span>
          <h3>{{ section.settings.preview_title }}</h3>
        </div>
        <span class="daily-preview__sun" aria-hidden="true">✦</span>
      </header>

      <div class="daily-preview__section daily-preview__scripture">
        <span class="daily-preview__label">{{ section.settings.preview_scripture_label }}</span>
        <blockquote>“{{ section.settings.preview_verse }}”</blockquote>
        <cite>{{ section.settings.preview_reference }}</cite>
      </div>

      <div class="daily-preview__section">
        <span class="daily-preview__label">{{ section.settings.preview_devotion_label }}</span>
        <p>{{ section.settings.preview_devotion }}</p>
      </div>

      <div class="daily-preview__section daily-preview__prayer">
        <span class="daily-preview__label">{{ section.settings.preview_prayer_label }}</span>
        <p>{{ section.settings.preview_prayer }}</p>
      </div>

      <footer>{{ section.settings.preview_footer }}</footer>
    </article>
  </div>
</section>

<section class="guide-capture" aria-labelledby="GuideCaptureTitle-{{ section.id }}">
  <div class="page-width guide-capture__inner">
    <div>
      <span class="eyebrow">A free gift for your week</span>
      <h2 class="section-title" id="GuideCaptureTitle-{{ section.id }}">{{ section.settings.guide_heading }}</h2>
      <p>{{ section.settings.guide_copy }}</p>
    </div>
    {% form 'customer', class: 'guide-capture__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,7-day-scripture-prayer-guide">
      <label class="visually-hidden" for="GuideEmail-{{ section.id }}">Email address</label>
      <input id="GuideEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="Your email address" required>
      <button class="button button--gold" type="submit" data-analytics-event="email_guide_signup">Unlock my free guide</button>
      {% if form.posted_successfully? %}
        <div class="guide-capture__delivery">
          <p class="form-success"><strong>Your guide is ready.</strong> Save this page and begin with Day 1.</p>
          <ol>
            <li><strong>Day 1 · Be still</strong><span>Read Psalm 46:10. Ask God to quiet the noise and make you aware of His presence.</span></li>
            <li><strong>Day 2 · Ask for wisdom</strong><span>Read James 1:5. Name one decision and ask God for wisdom without fear.</span></li>
            <li><strong>Day 3 · Release your worry</strong><span>Read Philippians 4:6–7. Turn each anxious thought into a specific prayer.</span></li>
            <li><strong>Day 4 · Receive new strength</strong><span>Read Isaiah 40:31. Ask for strength for the next faithful step—not the whole journey.</span></li>
            <li><strong>Day 5 · Rest in grace</strong><span>Read 2 Corinthians 12:9. Bring God one weakness you have been trying to hide.</span></li>
            <li><strong>Day 6 · Practice love</strong><span>Read John 13:34–35. Pray for one person you can encourage in a practical way today.</span></li>
            <li><strong>Day 7 · Walk it out</strong><span>Read Micah 6:8. Ask God to help you act justly, love mercy, and walk humbly this week.</span></li>
          </ol>
        </div>
      {% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
</section>

<section class="collections-section">
  <div class="page-width">
    <span class="eyebrow">Beyond The Bible Band™</span><h2 class="section-title">More Ways To Engage Your Faith</h2>
    <div class="collection-cards">
      {% assign collection_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'collection' %}
          {% assign collection_index = collection_index | plus: 1 %}
          {% case collection_index %}
            {% when 1 %}{% assign collection_fallback = '/collections/devotionals' %}
            {% when 2 %}{% assign collection_fallback = '/collections/printables' %}
            {% else %}{% assign collection_fallback = '/collections/faith-apparel' %}
          {% endcase %}
          <a class="collection-card" href="{{ block.settings.collection.url | default: collection_fallback }}" {{ block.shopify_attributes }}><h3>{{ block.settings.heading | default: block.settings.collection.title }}</h3><p>{{ block.settings.copy }}</p><span>Explore →</span></a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="quote-section"><div class="page-width"><blockquote>“{{ section.settings.quote }}”<cite>{{ section.settings.quote_cite }}</cite></blockquote></div></section>

<section class="founder"><div class="page-width founder__grid">
  <div class="founder__photo">{% if section.settings.founder_image != blank %}{{ section.settings.founder_image | image_url: width: 1200 | image_tag: widths: '500,800,1200', loading: 'lazy', alt: section.settings.founder_image.alt | default: 'Bible House Goods founder' }}{% else %}<img src="{{ 'founders.jpeg' | asset_url }}" alt="Clark Whitney and his wife" width="1200" height="900" loading="lazy">{% endif %}</div>
  <div class="founder__copy"><span class="eyebrow">Our Story</span><h2 class="section-title">{{ section.settings.founder_heading }}</h2><p>{{ section.settings.founder_copy }}</p><a class="button" href="{{ section.settings.founder_link }}">Read Our Story</a></div>
</div></section>

<section class="home-groups">
  <div class="page-width home-groups__inner">
    <div class="home-groups__copy">
      <span class="eyebrow">Bible Band™ Church Packs</span>
      <h2 class="display-title">Put the Word in every hand.</h2>
      <p>Equip your church, camp, youth ministry, school, retreat, or outreach with Bible Bands and a flexible church hub for Scripture, prayer guides, giving, bulletins, sermon notes, events, and next steps.</p>
      <div class="home-groups__actions">
        <a class="button button--gold" href="{{ section.settings.groups_link | default: '/pages/bible-band-church-packs' }}">Explore church packs</a>
        <a class="home-groups__text-link" href="{{ section.settings.groups_contact_link | default: '/pages/contact' }}">Ask about group pricing <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="home-groups__callouts" aria-label="Ways groups use the Bible Band">
      <span class="home-groups__ribbon">Made for ministry</span>
      <div class="home-groups__badge"><strong>21</strong><span>Days of Prayer</span></div>
      <ul>
        <li><span>01</span>Church-wide Scripture</li>
        <li><span>02</span>Custom Church Hub</li>
        <li><span>03</span>Camps &amp; Student Ministry</li>
        <li><span>04</span>Events &amp; Next Steps</li>
        <li><span>05</span>Group Pricing</li>
      </ul>
    </div>
  </div>
</section>

<section class="final-cta"><div class="page-width"><h2 class="display-title">Every Day.<br>One Tap.</h2><p>Start your wearable discipleship journey with The Bible Band™.</p><div class="button-row"><a class="button button--gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-analytics-event="hero_cta_click" data-analytics-label="Final homepage CTA">Get The Bible Band™</a><a class="button button--outline" href="{{ routes.all_products_collection_url }}">Shop All</a></div></div></section>

