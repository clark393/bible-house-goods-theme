  .community-proof__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px}.community-proof__actions a,.social-post__link,.review-card footer a{font-size:10px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase;text-underline-offset:4px}
  .community-proof__actions a{padding:12px 14px;border:1px solid var(--ink);text-decoration:none}.community-proof__actions a:hover{background:var(--ink);color:var(--cream)}
  .community-proof__rail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:stretch}
  .social-post,.review-card{min-width:0;border:2px solid var(--ink);background:var(--cream);color:var(--ink);box-shadow:7px 7px 0 var(--gold)}
  .social-post{display:flex;flex-direction:column;text-decoration:none}.social-post__media{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--ink)}.social-post__media video,.social-post__media img{width:100%;height:100%;object-fit:cover}.social-post__platform{position:absolute;top:10px;left:10px;padding:7px 9px;background:var(--ink);color:var(--cream);font-size:9px;font-weight:950;letter-spacing:1px;text-transform:uppercase}.social-post__placeholder{display:flex;height:100%;align-items:center;justify-content:center;flex-direction:column;gap:12px;background:linear-gradient(150deg,var(--rust),var(--ink));color:var(--cream)}.social-post__placeholder span{display:flex;width:56px;height:56px;align-items:center;justify-content:center;border:2px solid var(--gold);border-radius:50%;font-size:10px;font-weight:900;text-transform:uppercase}.social-post p{margin:0;padding:18px 18px 8px;font-size:14px;font-weight:800;line-height:1.45}.social-post__link{margin-top:auto;padding:0 18px 18px}
  .review-card{display:flex;min-height:360px;flex-direction:column;padding:26px}.review-card__stars{color:var(--rust);font-size:15px;letter-spacing:2px}.review-card blockquote{margin:28px 0;font-family:var(--font-heading-family);font-size:clamp(24px,2.3vw,34px);font-weight:800;letter-spacing:-.025em;line-height:1.12}.review-card footer{display:flex;align-items:flex-start;flex-direction:column;gap:5px;margin-top:auto;padding-top:18px;border-top:1px solid #c8b8a5}.review-card footer strong{font-size:11px;letter-spacing:1px;text-transform:uppercase}.review-card footer span{color:var(--brown);font-size:11px}
