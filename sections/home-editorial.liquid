    {"type":"text","id":"preview_footer","label":"Preview footer","default":"A fresh experience is waiting every day with The Bible Band™."},
    {"type":"text","id":"products_heading","label":"Products heading","default":"From Our Shop"},
    {"type":"collection","id":"collection","label":"Featured collection"},
    {"type":"header","content":"Social proof"},
    {"type":"text","id":"social_kicker","label":"Social proof kicker","default":"From the community"},
    {"type":"text","id":"social_heading","label":"Social proof heading","default":"Faith in real life"},
    {"type":"textarea","id":"social_copy","label":"Social proof introduction","default":"See how people are using Bible House Goods, then hear what customers have to say."},
    {"type":"header","content":"Free guide email signup"},
    {"type":"text","id":"guide_heading","label":"Heading","default":"Get the free 7-day Scripture & prayer guide"},
    {"type":"textarea","id":"guide_copy","label":"Description","default":"Join the list to unlock seven short daily readings and guided prayers that help you begin a steady rhythm with God."},
    {"type":"textarea","id":"quote","label":"Quote","default":"Keep God's Word close to your heart and carry it with you daily."},
    {"type":"text","id":"quote_cite","label":"Citation","default":"Deuteronomy 11:18"},
