{% doc %}
Renders the Judge.me product review widget and review submission form.

@param {product} product - The product whose reviews are displayed.

@example
{% render 'judgeme-review-widget', product: product %}
{% enddoc %}

{% if product != blank %}
  {% liquid
    assign has_legacy = false
    if product.metafields.judgeme.widget.size > 20
      assign has_legacy = true
    endif
  %}
  <div class="judgeme-reviews page-width">
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-product-title="{{ product.title | escape }}"
      data-id="{{ product.id }}"
      data-product-id="{{ product.id }}"
      data-widget="review"
      data-auto-install="false"
      data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
      data-entry-point="review_widget.js"
      data-entry-key="review-widget/main.js"
    >
      {% if has_legacy %}
        <div class="jdgm-legacy-widget-content" style="display: none;">
          {{ product.metafields.judgeme.widget }}
        </div>
      {% endif %}
    </div>
  </div>
  {% if product.metafields.judgeme.review_widget_data %}
    <script>
      jdgm.data ||= {};
      jdgm.data.reviewWidget ||= {};
      jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
    </script>
  {% endif %}
{% endif %}

{% stylesheet %}
  .judgeme-reviews {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(72px, 9vw, 128px);
  }
  #judgeme_product_reviews {
    --jdgm-primary-color: var(--rust);
    --jdgm-secondary-color: var(--gold);
    --jm-primary-color: var(--rust);
    --jm-accent-color: var(--gold);
    accent-color: var(--rust);
  }
  #judgeme_product_reviews a,
  #judgeme_product_reviews [class*="link"] {
    color: var(--rust) !important;
  }
  #judgeme_product_reviews button,
  #judgeme_product_reviews [role="button"] {
    border-color: var(--rust) !important;
  }
  #judgeme_product_reviews button:not([disabled]),
  #judgeme_product_reviews [role="button"]:not([aria-disabled="true"]) {
    background-color: var(--rust) !important;
    color: var(--cream) !important;
  }
  #judgeme_product_reviews [class*="star"] {
    color: var(--gold) !important;
  }
  @media (max-width: 640px) {
    .judgeme-reviews {
      width: min(100% - 28px, 1400px);
      padding-top: 48px;
      padding-bottom: 96px;
    }
    #judgeme_product_reviews button,
    #judgeme_product_reviews [role="button"] {
      min-height: 44px;
    }
  }
{% endstylesheet %}
